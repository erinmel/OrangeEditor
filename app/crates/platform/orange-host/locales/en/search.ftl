# Words the node search finds nodes by, in English (docs/13, docs/22 §4).
#
# concept-<id>          words for a purpose that groups nodes (comma separated)
# concept-<id>-purpose  one line on what nodes of that purpose do
# category-<slug>       more words for a palette category
# alias-<node key>      more words for one node; the key is its ID with "/" and "." as "-"
# purpose-<node key>    one line on what one node does
#
# IDs never change with the language; a locale only adds words. Wireless nodes also carry
# their names in the other language, so either works in any interface language.

language-name = English

concept-trigger = trigger, when, start, event, on, entry, begin, run
concept-trigger-purpose = Starts the flow when something happens.
concept-math = math, maths, arithmetic, calculate, number, sum
concept-math-purpose = Calculates with numbers.
concept-compare = compare, comparison, equal, greater, less, same, check
concept-compare-purpose = Compares two values.
concept-logic = logic, if, condition, boolean, branch, choose
concept-logic-purpose = Chooses a way on a condition.
concept-text = text, string, words, characters, letters
concept-text-purpose = Works with text.
concept-time = time, clock, timer, delay, wait, interval, schedule
concept-time-purpose = Waits for or reads the time.
concept-color = color, colour, rgb, rgba, hex, palette, alpha, opacity
concept-color-purpose = Creates or converts colors.
purpose-org-orange-color-color = Choose a color with a swatch or connect a typed color.
purpose-org-orange-color-split-rgba = Returns the four channels as whole numbers from 0 to 255.
purpose-org-orange-time-parse-timestamp = Reads RFC 3339 or exact Unix seconds, milliseconds, microseconds or nanoseconds.
purpose-org-orange-time-format-timestamp = Writes RFC 3339 with a UTC offset or an exact Unix timestamp.
purpose-org-orange-time-duration-in-units = Returns whole units, rounding toward zero.
purpose-org-orange-time-convert-time-units = Scales decimal seconds, milliseconds, microseconds, nanoseconds, minutes or hours.
concept-audio = audio, sound, music, microphone, speaker, volume
concept-audio-purpose = Plays or listens to sound.
concept-network = network, internet, web, http, request, mqtt, websocket, online
concept-network-purpose = Talks to other machines.
concept-file = file, folder, disk, path, directory, save, load
concept-file-purpose = Reads or writes files and folders.
concept-variable = variable, state, store, remember, memory, value
concept-variable-purpose = Reads or keeps a value between runs.
concept-loop = loop, repeat, each, iterate, cycle, times
concept-loop-purpose = Repeats work.
concept-list = list, array, collection, map, dictionary, record
concept-list-purpose = Works with lists, maps and records.
concept-data = json, data, parse, field
concept-data-purpose = Reads values out of JSON.

alias-core-whole-number = integer, whole number, i64, u64, count, number
alias-core-number = number, decimal, real, f64, f32, double
alias-core-true-or-false = boolean, true or false, flag, switch
alias-core-text = string, str, words
alias-core-value = constant, literal
alias-core-wait = delay, sleep, pause
alias-core-set-variable = assign, store, write
alias-core-get-variable = read, load
alias-core-branch = if, else, condition, guard
alias-core-coalesce = coalesce, fallback, optional, use default if missing, option, alternativa, valor opcional
purpose-core-coalesce = Keep an optional value when present. If it is missing, use the fallback instead.
alias-core-all-conditions = all conditions, every condition, boolean and, short circuit
alias-core-any-conditions = any conditions, either condition, boolean or, short circuit
purpose-core-all-conditions = True when every input is true. Checks them in order and stops at the first false; add inputs as you need them.
purpose-core-any-conditions = True when any input is true. Checks them in order and stops at the first true; add inputs as you need them.
alias-core-count = for loop, counted loop, repeat n times, repeat times
purpose-core-count = Runs Body once per count, with an index starting at zero. Completed runs when the loop ends.
alias-core-for-range = range loop, descending, stepped loop, exclusive range
purpose-core-for-range = Runs Body from Start up to but excluding End, moving by Step. Index is available in Body. Negative steps count down.
purpose-core-while = Checks Condition before the first iteration and after each Body completes. Done runs when Condition becomes false.
purpose-core-match-option = Routes present and missing values separately. The unpacked value is available on Present.
alias-core-repeat-begin = repeat loop, repeat begin, carry, accumulator
alias-core-map-begin = transform list, map begin
alias-core-filter-begin = keep items, filter begin
alias-core-fold-begin = fold, reduce list, fold begin
purpose-core-repeat-begin = Places both ends of a repeat loop. Supply Initial and Count, then wire each iteration's Next value.
purpose-core-map-begin = Places both ends of a loop that transforms every item into a result list.
purpose-core-filter-begin = Places both ends of a loop that keeps items when the Keep input is true.
purpose-core-fold-begin = Places both ends of a loop that combines items into one result.
purpose-org-orange-text-format = Formats numbered arguments into text. Use double braces for literal braces and :. followed by digits for decimal precision.
purpose-org-orange-text-inspect-error = Gives the stable error code for logging or routing.
purpose-org-orange-text-encode-base64 = Encodes bytes as standard padded Base64 text.
purpose-org-orange-text-decode-base64 = Decodes standard padded Base64 text into bytes.
purpose-org-orange-text-encode-hex = Encodes bytes as lowercase hexadecimal text.
purpose-org-orange-text-regex-match = Tests whether a regular expression matches anywhere in the text.
purpose-org-orange-text-regex-extract = Returns the first regular expression match when one exists.
purpose-org-orange-text-parse-csv = Reads comma-separated text as rows of fields, including quoted fields and multiline values.
purpose-org-orange-text-write-csv = Converts rows of text fields to CSV, adding quotes when needed.
purpose-org-orange-text-decode-hex = Decodes uppercase or lowercase hexadecimal text into bytes.
alias-org-orange-audio-play = sound, audio, speaker, music

purpose-core-on-manual = Starts an activation when you press Fire on this node in a running graph.
purpose-core-on-start = Starts once when the flow starts.
purpose-core-on-stop = Runs once when the flow stops.
purpose-core-on-timer = Starts again and again on a timer.
purpose-core-on-timeout = Starts once after a delay.
purpose-core-on-event = Listens on a channel and starts a flow each time it is dispatched, with its payload when it has one.
purpose-core-on-variable-changed = Starts when a variable changes.
purpose-core-on-watch = Starts when a watched value changes, becomes true or false, or crosses a threshold or range.
alias-core-on-watch = on watch, threshold, condition, rising edge, falling edge, range
purpose-core-wait = Waits for a while, then goes on.
purpose-core-branch = Goes one way if true, the other if false.
purpose-core-whole-number = A whole number you type.
purpose-core-number = A decimal number you type.
purpose-core-true-or-false = True or false, as you set it.
purpose-core-text = A text you type.

# Collections and JSON, one line per node.
purpose-org-orange-collections-list-length = Counts the items of a list.
purpose-org-orange-collections-build-list = Builds a list from addable items in port order.
purpose-org-orange-collections-build-map = Pairs keys and values by list index. The lists must have equal lengths and keys must be unique.
purpose-org-orange-collections-list-set-at = Replaces an item at a zero-based index. An index outside the list fails.
purpose-org-orange-collections-list-remove-at = Removes an item at a zero-based index. Later items move one position earlier.
purpose-org-orange-collections-list-distinct = Keeps the first occurrence of each distinct value in list order.
purpose-org-orange-collections-list-sort = Sorts in ascending order, preserving the order of equal items.
purpose-org-orange-collections-option-some = Wraps a value as present, even when that value is itself an empty option.
purpose-org-orange-collections-option-none = Creates an empty option of the selected type.
purpose-org-orange-collections-list-get = Gives the item at an index of a list, or nothing past its end.
purpose-org-orange-collections-list-slice = Gives part of a list: a count of items from a start index; fails past the end.
purpose-org-orange-collections-list-concat = Joins two lists, the items of a then those of b.
purpose-org-orange-collections-list-append = Gives the list with one more item at its end.
purpose-org-orange-collections-list-contains = Tells whether a list holds a value.
purpose-org-orange-collections-list-index-of = Gives where a value first appears in a list, or nothing.
purpose-org-orange-collections-list-reverse = Gives the list in the opposite order.
purpose-org-orange-collections-map-length = Counts the entries of a map.
purpose-org-orange-collections-map-get = Gives the value stored under a key, or nothing.
purpose-org-orange-collections-map-contains-key = Tells whether a map has a key.
purpose-org-orange-collections-map-insert = Gives the map with a value stored under a key, replacing any there.
purpose-org-orange-collections-map-remove = Gives the map without a key and its value.
purpose-org-orange-collections-map-keys = Lists the keys of a map.
purpose-org-orange-collections-map-values = Lists the values of a map.
purpose-org-orange-collections-option-is-some = Tells whether an optional value holds something.
purpose-org-orange-collections-make-record = Builds a record of one of the graph's types from its fields.
purpose-org-orange-collections-get-field = Reads one field of a record.
purpose-org-orange-collections-set-field = Gives the record with one field changed.
purpose-org-orange-collections-make-enum = Picks one choice of an enum, with its payload when it has one.
purpose-org-orange-collections-enum-payload = Reads the payload a choice of an enum carries. Needs an enum with a choice that carries one.
purpose-org-orange-json-parse = Reads JSON text into a JSON value; fails on text that is not JSON.
purpose-org-orange-json-build-object = Builds a JSON object from a map of text keys and JSON values.
purpose-org-orange-json-build-array = Builds a JSON array in the order of the input list.
purpose-org-orange-json-set-field = Adds or replaces a field in a JSON object.
purpose-org-orange-json-remove-field = Removes a field from a JSON object if it exists.
purpose-org-orange-json-from-bool = Converts a boolean to a JSON boolean.
purpose-org-orange-json-from-string = Encodes text as a JSON string, including quotes and escapes.
purpose-org-orange-json-from-i64 = Converts a signed integer to an exact JSON number.
purpose-org-orange-json-from-u64 = Converts an unsigned integer to an exact JSON number.
purpose-org-orange-json-from-f64 = Converts a finite floating-point value to a JSON number.
purpose-org-orange-json-null = Produces an explicit JSON null value.
purpose-org-orange-json-kind = Says what a JSON value is: object, array, string, number, boolean or null.
purpose-org-orange-json-is-null = Tells whether a JSON value is null.
purpose-org-orange-json-get = Gives the field of a JSON object by name, or nothing when it has none; fails on a value that is not an object.
purpose-org-orange-json-get-path = Reads nested JSON fields and array items using a path like items[0].name or headers["Content-Type"].
purpose-org-orange-json-at = Gives the item of a JSON array at an index, or nothing past its end; fails on a value that is not an array.
purpose-org-orange-json-length = Counts the items of a JSON array or the fields of an object; fails on any other kind.
purpose-org-orange-json-as-bool = Gives a JSON boolean as true or false, or nothing for any other kind.
purpose-org-orange-json-as-string = Gives a JSON string as text, or nothing for any other kind.
purpose-org-orange-json-as-i64 = Gives a JSON number as a whole number, or nothing for another kind; fails on a fraction or one too large.
purpose-org-orange-json-as-u64 = Gives a JSON number as a whole number of zero or more, or nothing for another kind; fails on a fraction, a negative or one too large.
purpose-org-orange-json-as-f64 = Gives a JSON number as a decimal, or nothing for any other kind.
purpose-org-orange-json-read-text = Reads the text at a path such as user.name in one step, or gives the fallback when it is missing or not text.
purpose-org-orange-json-read-int = Reads the whole number at a path such as items[0].id in one step, or gives the fallback when it is missing, not whole or too big.
purpose-org-orange-json-read-number = Reads the number at a path such as price in one step, or gives the fallback when it is missing or not a number.
purpose-org-orange-json-read-bool = Reads true or false at a path such as user.admin in one step, or gives the fallback when it is missing or another kind.
alias-org-orange-json-read-text = extract, field, value, get, json path, read field, string
alias-org-orange-json-read-int = extract, field, value, get, json path, read field, integer, int, count
alias-org-orange-json-read-number = extract, field, value, get, json path, read field, decimal, float
alias-org-orange-json-read-bool = extract, field, value, get, json path, read field, boolean, flag
purpose-core-get-variable = Gives the value a variable holds now.
purpose-core-set-variable = Replaces a variable's value with the one you give, then continues.
purpose-core-update-variable = Changes a variable from its current value, such as adding one, then continues with the old and new values.
purpose-core-set-shared = Replaces the value of a variable shared by all graphs, then continues.
purpose-core-update-shared = Changes a variable shared by all graphs from its current value, then continues with the old and new values.
purpose-core-emit = Dispatches an event on a channel to every Listen, with an optional payload, and continues.
alias-core-emit = emit, send, broadcast, fan out, event, payload, wireless, signal, emitter, publish, pulse, despachar, emitir, enviar, emisor, inalámbrico, señal
alias-core-on-event = on event, receive, subscribe, subscriber, event, trigger, payload, wireless, signal, receiver, pulse, escuchar, recibir, suscriptor, inalámbrico, señal
purpose-core-bridge-out = Exposes a value on a named channel for every Bridge In, without a wire and without starting a flow.
purpose-core-bridge-in = Reads its Bridge Out's value when something pulls it. It never starts a flow and is not a variable.
alias-core-bridge-out = bridge, value, pull, wireless, send value, share, expose, emitter, out, puente, salida, inalámbrico
alias-core-bridge-in = bridge, value, pull, wireless, read value, receive, get, subscriber, in, puente, entrada, inalámbrico

