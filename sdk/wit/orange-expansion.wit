/// OrangeEditor package interface (ADR-03, K02b). Versioned with the host API.
package orange:expansion@1.0.0;

/// Shared types.
interface types {
    /// One Orange value. The host checks every value against the type it expects.
    ///
    /// `literal` is the `orange.value.v1` codec: the JSON text of
    /// `{"type": <canonical type>, "value": ...}`, or `"bits"` for floats (12 §6). It
    /// can carry any value.
    ///
    /// The other cases carry bulk data without text conversion and are valid only for
    /// the exact type named: `bytes` for `core/bytes@1`, and each list case for
    /// `core/list@1<T>` of that scalar. The host sends these types in their binary
    /// case; a guest may return either form.
    variant value {
        literal(string),
        bytes(list<u8>),
        i32-list(list<s32>),
        i64-list(list<s64>),
        u32-list(list<u32>),
        u64-list(list<u64>),
        f32-list(list<f32>),
        f64-list(list<f64>),
    }

    /// A node failure the guest reports itself. `code` is a namespaced error code
    /// (`namespace/Name`) and `message-key` a namespaced catalogue key; no free text.
    record node-error {
        code: string,
        message-key: string,
    }
}

/// Always granted: facts about the host.
interface host {
    /// The host API version as (major, minor).
    api-version: func() -> tuple<u16, u16>;
}

/// Granted only with the `log` permission. The host bounds and may drop entries.
interface log {
    write: func(message: string);
}

/// Granted only with the `files` permission: the package's own data directory, which
/// the application keeps for it. Nothing outside that directory can be named. A path
/// is relative, with `/` between plain names. Errors are one of `not-found`,
/// `invalid-path`, `too-large`, `quota-exceeded`, `unavailable` and `failed`.
interface files {
    /// Reads a whole file.
    read: func(path: string) -> result<list<u8>, string>;
    /// Creates or replaces a file, creating the directories on its path.
    write: func(path: string, data: list<u8>) -> result<_, string>;
    /// The names in a directory, sorted; `""` is the data directory itself and a
    /// directory's name ends with `/`.
    %list: func(path: string) -> result<list<string>, string>;
    /// Deletes a file.
    remove: func(path: string) -> result<_, string>;
}

/// Granted only with the `http` permission: HTTPS requests through the application's
/// network client. A call blocks the node until the answer arrives, so it belongs in an
/// async node. Errors are one of `invalid-request`, `not-allowed`, `too-large`,
/// `unavailable` and `failed`.
interface http {
    record request {
        /// `GET`, `HEAD`, `POST`, `PUT`, `PATCH` or `DELETE`.
        method: string,
        /// An `https://` URL.
        url: string,
        headers: list<tuple<string, string>>,
        body: list<u8>,
    }
    record response {
        status: u16,
        body: list<u8>,
    }
    send: func(request: request) -> result<response, string>;
}

/// Pure node implementations contributed by the package.
interface nodes {
    use types.{value, node-error};

    /// Evaluates `definition` (a namespaced definition ID) on its inputs in declared
    /// port order, returning outputs in declared port order. Must be a function of
    /// its inputs: the host may fold, cache or repeat the call.
    evaluate: func(definition: string, inputs: list<value>) -> result<list<value>, node-error>;
}

/// Action and async node implementations contributed by the package.
interface effects {
    use types.{value, node-error};

    /// Runs `definition` once, when control reaches the node. Unlike `evaluate` it is
    /// never folded, cached or repeated, so it may keep state in the instance: every
    /// call for one node of one compiled graph reaches the same instance.
    ///
    /// An action node is called on the run's own thread and must be quick. An async
    /// node is called by the host off the run, and the graph continues when it returns.
    execute: func(definition: string, inputs: list<value>) -> result<list<value>, node-error>;
}

world plugin {
    import host;
    import log;
    import files;
    import http;
    export nodes;
    export effects;
}
