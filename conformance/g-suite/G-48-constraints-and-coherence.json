      "expect": {
        "diagnostics": [],
        "behaviour": {
          "rule": "R-5.4-ord-floats-explicit",
          "expect": "A generic node whose type parameter requires ord, instantiated with core/f32@1 or core/f64@1, is E-CONSTRAINT-UNSATISFIED; float ordering exists only through an explicit total-order node"
