        "variables": [
          {
            "id": "30000000-0000-4000-8000-000000000001",
            "name": "v",
            "type": "list<string>",
            "scope": "run",
            "persistent": false,
            "conflict": "reject"
          }
        ],
        "events": [],
        "signatures": {},
        "nodes": [],
        "edges": [],
        "functions": [],
        "exports": [],
        "editor": {}
      },
      "expect": {
        "diagnostics": [],
        "behaviour": {
          "rule": "R-5.1-canonical-persisted",
          "expect": "Loading rejects the non-canonical type text list<string>; the persisted form is core/list@1<core/string@1> and saving never writes a short form"
